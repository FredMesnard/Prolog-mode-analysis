+/* Dynamic variable reordering control.
+
+   init/1 unconditionally turns on CUDD_REORDER_GROUP_SIFT, and there was no
+   way to observe or change that from Prolog. Since sifting fires on
+   node-count thresholds reached during construction, its cost is hard to
+   predict and can dominate; being able to switch it off makes the effect
+   measurable. */
+static const struct { const char * name; Cudd_ReorderingType type; }
+reorder_methods[] = {
+  {"none",            CUDD_REORDER_NONE},
+  {"same",            CUDD_REORDER_SAME},
+  {"random",          CUDD_REORDER_RANDOM},
+  {"random_pivot",    CUDD_REORDER_RANDOM_PIVOT},
+  {"sift",            CUDD_REORDER_SIFT},
+  {"sift_converge",   CUDD_REORDER_SIFT_CONVERGE},
+  {"symm_sift",       CUDD_REORDER_SYMM_SIFT},
+  {"symm_sift_conv",  CUDD_REORDER_SYMM_SIFT_CONV},
+  {"window2",         CUDD_REORDER_WINDOW2},
+  {"window3",         CUDD_REORDER_WINDOW3},
+  {"window4",         CUDD_REORDER_WINDOW4},
+  {"window2_conv",    CUDD_REORDER_WINDOW2_CONV},
+  {"window3_conv",    CUDD_REORDER_WINDOW3_CONV},
+  {"window4_conv",    CUDD_REORDER_WINDOW4_CONV},
+  {"group_sift",      CUDD_REORDER_GROUP_SIFT},
+  {"group_sift_conv", CUDD_REORDER_GROUP_SIFT_CONV},
+  {"annealing",       CUDD_REORDER_ANNEALING},
+  {"genetic",         CUDD_REORDER_GENETIC},
+  {"linear",          CUDD_REORDER_LINEAR},
+  {"linear_converge", CUDD_REORDER_LINEAR_CONVERGE},
+  {"lazy_sift",       CUDD_REORDER_LAZY_SIFT},
+  {"exact",           CUDD_REORDER_EXACT},
+  {NULL,              CUDD_REORDER_NONE}
+};
+
+/* set_reordering(+Env,+Method)
+   Method is one of the atoms above; 'none' disables automatic reordering.
+   Fails on an unknown method rather than silently doing nothing. */
+static foreign_t set_reordering(term_t arg1, term_t arg2)
+{
+  environment * env;
+  char * name;
+  int i,ret;
+
+  ret=PL_get_pointer(arg1,(void **)&env);
+  RETURN_IF_FAIL
+  ret=PL_get_atom_chars(arg2,&name);
+  RETURN_IF_FAIL
+
+  for (i=0;reorder_methods[i].name!=NULL;i++)
+  {
+    if (strcmp(name,reorder_methods[i].name)==0)
+    {
+      if (reorder_methods[i].type==CUDD_REORDER_NONE)
+        Cudd_AutodynDisable(env->mgr);
+      else
+        Cudd_AutodynEnable(env->mgr,reorder_methods[i].type);
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
+
+/* reordering_status(+Env,-Method)
+   'none' when automatic reordering is off, else the active method. */
+static foreign_t reordering_status(term_t arg1, term_t arg2)
+{
+  environment * env;
+  Cudd_ReorderingType method;
+  term_t out;
+  int i,ret,on;
+
+  ret=PL_get_pointer(arg1,(void **)&env);
+  RETURN_IF_FAIL
+
+  method=CUDD_REORDER_NONE;
+  on=Cudd_ReorderingStatus(env->mgr,&method);
+  out=PL_new_term_ref();
+
+  if (!on)
+  {
+    ret=PL_put_atom_chars(out,"none");
+    RETURN_IF_FAIL
+    return PL_unify(out,arg2);
+  }
+  for (i=0;reorder_methods[i].name!=NULL;i++)
+  {
+    if (reorder_methods[i].type==method)
+    {
+      ret=PL_put_atom_chars(out,reorder_methods[i].name);
+      RETURN_IF_FAIL
+      return PL_unify(out,arg2);
+    }
+  }
+  ret=PL_put_atom_chars(out,"unknown");
+  RETURN_IF_FAIL
+  return PL_unify(out,arg2);
+}
