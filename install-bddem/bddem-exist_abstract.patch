+/* exist_abstract(+Env,+BDD,+ListOfVarIndices,-Out)
+
+   Existential quantification, i.e. exists V1..Vk . BDD, wrapping CUDD's
+   Cudd_bddExistAbstract. CUDD already implements this; only the Prolog
+   binding was missing, which forced callers to expand
+   "exists x F(x) <=> F(0) or F(1)" at the term level, doubling the formula
+   per eliminated variable.
+
+   The variables are given by their multi-valued indices, as returned by
+   add_var/4. The positive cube required by CUDD is built here rather than
+   in Prolog on purpose: a multi-valued variable spans several Boolean
+   variables, and for a binary one equality(V,0) is the POSITIVE literal
+   while equality(V,1) is the negative one, so a cube assembled in Prolog
+   from equality/4 results would be encoding-dependent and easy to get
+   silently wrong.
+
+   Encoding: a plain variable occupies nVal-1 Boolean variables starting at
+   firstBoolVar; a query variable occupies nVal of them. */
+static foreign_t exist_abstract(term_t arg1, term_t arg2, term_t arg3,
+                                term_t arg4)
+{
+  term_t out,list,head;
+  DdNode * node, * cube, * tmp, * var, * nodeout;
+  environment * env;
+  variable v;
+  int varIndex,i,nb,last,ret,res;
+
+  ret=PL_get_pointer(arg1,(void **)&env);
+  RETURN_IF_FAIL
+  ret=PL_get_pointer(arg2,(void **)&node);
+  RETURN_IF_FAIL
+
+  cube=Cudd_ReadOne(env->mgr);
+  Cudd_Ref(cube);
+
+  list=PL_copy_term_ref(arg3);
+  head=PL_new_term_ref();
+  while (PL_get_list(list,head,list))
+  {
+    if (!PL_get_integer(head,&varIndex))
+    {
+      Cudd_RecursiveDeref(env->mgr,cube);
+      return FALSE;
+    }
+    if (varIndex<0 || varIndex>=env->nVars)
+    {
+      Cudd_RecursiveDeref(env->mgr,cube);
+      return FALSE;
+    }
+    v=env->vars[varIndex];
+    nb=v.query ? v.nVal : v.nVal-1;
+    last=v.firstBoolVar+nb;
+    if (last>env->boolVars)
+      last=env->boolVars;
+    for (i=v.firstBoolVar;i<last;i++)
+    {
+      var=Cudd_bddIthVar(env->mgr,i);
+      tmp=Cudd_bddAnd(env->mgr,cube,var);
+      if (tmp==NULL)
+      {
+        Cudd_RecursiveDeref(env->mgr,cube);
+        return FALSE;
+      }
+      Cudd_Ref(tmp);
+      Cudd_RecursiveDeref(env->mgr,cube);
+      cube=tmp;
+    }
+  }
+  if (!PL_get_nil(list))
+  {
+    Cudd_RecursiveDeref(env->mgr,cube);
+    return FALSE;
+  }
+
+  nodeout=Cudd_bddExistAbstract(env->mgr,node,cube);
+  if (nodeout==NULL)
+  {
+    Cudd_RecursiveDeref(env->mgr,cube);
+    return FALSE;
+  }
+  Cudd_Ref(nodeout);
+  Cudd_RecursiveDeref(env->mgr,cube);
+
+  out=PL_new_term_ref();
+  ret=PL_put_pointer(out,(void *) nodeout);
+  RETURN_IF_FAIL
+  res=PL_unify(out,arg4);
+  return res;
+}
+
 static foreign_t or(term_t arg1,term_t arg2,term_t arg3, term_t arg4)
 {
   term_t out;
@@ -3981,6 +4169,7 @@ install_t install()
   PL_register_foreign("add_abd_var",4,add_abd_var,0);
   PL_register_foreign("equality",4,equality,0);
   PL_register_foreign("and",4,and,0);
+  PL_register_foreign("exist_abstract",4,exist_abstract,0);
   PL_register_foreign("one",2,one,0);
   PL_register_foreign("zero",2,zero,0);
   PL_register_foreign("or",4,or,0);
@@ -3993,6 +4182,8 @@ install_t install()
