   PL_register_foreign("ret_map_prob",4,ret_map_prob,0);
   PL_register_foreign("reorder",1,reorder,0);
+  PL_register_foreign("set_reordering",2,set_reordering,0);
+  PL_register_foreign("reordering_status",2,reordering_status,0);
